<?xml version="1.0" encoding="UTF-8"?>
<Context>
    <!-- Context configuration for Movie Service SOAP deployment -->
    <Parameter name="movie-service.context" value="/movie-service" override="false"/>
    
    <!-- JAX-WS Configuration -->
    <Parameter name="com.sun.xml.ws.transport.http.servlet.contextRoot" 
               value="/movie-service" 
               override="false"/>
    
    <!-- Session configuration -->
    <Manager pathname="" />
    
    <!-- JVM arguments for better performance -->
    <JarScanner scanClassPath="false">
        <JarScanFilter defaultTldScan="false"/>
    </JarScanner>
</Context>
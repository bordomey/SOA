<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    
    <display-name>Movie Service - SOAP Implementation</display-name>
    
    <!-- JAX-WS Context Parameters -->
    <context-param>
        <param-name>com.sun.xml.ws.transport.http.servlet.contextRoot</param-name>
        <param-value>/</param-value>
    </context-param>
    
    <!-- JAX-WS Servlet Listener -->
    <listener>
        <listener-class>com.sun.xml.ws.transport.http.servlet.WSServletContextListener</listener-class>
    </listener>
    
    <!-- JAX-WS Servlet Configuration -->
    <servlet>
        <servlet-name>MovieServiceServlet</servlet-name>
        <servlet-class>com.sun.xml.ws.transport.http.servlet.WSServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>MovieServiceServlet</servlet-name>
        <url-pattern>/MovieService</url-pattern>
    </servlet-mapping>
    
    <!-- WSDL Access -->
    <servlet-mapping>
        <servlet-name>MovieServiceServlet</servlet-name>
        <url-pattern>/MovieService?wsdl</url-pattern>
    </servlet-mapping>
    
</web-app>